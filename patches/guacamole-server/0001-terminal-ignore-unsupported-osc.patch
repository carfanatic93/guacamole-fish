+int guac_terminal_osc_ignore(guac_terminal* term, unsigned char c) {
+
+    /* Stop on BEL or ECMA-48 ST (String Terminator), discarding everything
+     * else, including the ESC which precedes the 7-bit ST ("ESC \\") */
+    if (c == 0x9C || c == 0x5C || c == 0x07)
+        term->char_handler = guac_terminal_echo;
+
+    return 0;
+
+}
